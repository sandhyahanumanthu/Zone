# ==========================================
# DropZone Backend Environment Configuration
# ==========================================

# Server Port (Render injects PORT automatically; defaults to 5000 if unset)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ---------------------------------------------------------------------------------
# Database Connection String
# ---------------------------------------------------------------------------------
# For Local MongoDB (Compass / local daemon):
# MONGODB_URI=mongodb://127.0.0.1:27017/dropzone
#
# For MongoDB Atlas (Cloud deployment / Render):
# Format: mongodb+srv://<db_username>:<db_password>@<cluster_domain>/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/dropzone?retryWrites=true&w=majority

# ---------------------------------------------------------------------------------
# Frontend Client URL (For CORS configuration)
# ---------------------------------------------------------------------------------
# Local development:
CLIENT_URL=http://localhost:5173
# Production (Render / Vercel frontend URL, e.g. https://dropzone-client.onrender.com):
# CLIENT_URL=https://your-dropzone-frontend.onrender.com

# ---------------------------------------------------------------------------------
# Security & Authentication
# ---------------------------------------------------------------------------------
# Secret key used for signing JSON Web Tokens. Replace with a secure random string (at least 32+ characters).
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_string
